# Copy this file to .env at the repo root for local (non-Docker) development.
# In Docker/deployment, these are provided as real environment variables/secrets instead.
#
# See docs/architecture.md (13. Deployment) and server/app/core/config.py for how these are consumed.

# --- Model provider selection (provider-agnostic adapter, see server/app/llm/) ---
# One of: openai | anthropic | ollama
MODEL_PROVIDER=openai

# Default model used by every stage unless overridden below.
MODEL_NAME=gpt-4o-mini

# Optional per-stage overrides. Leave unset to fall back to MODEL_NAME.
# Setting a different VERIFIER_MODEL is a documented mitigation for verifier
# independence (see docs/architecture.md, 9. Verifier Architecture).
PLANNER_MODEL=
EXTRACTOR_MODEL=
VERIFIER_MODEL=

# --- Provider credentials (only the one matching MODEL_PROVIDER is required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Database ---
# Leave unset to use the built-in default: <repo_root>/server/data/app.db
# (computed in server/app/core/config.py so it resolves correctly regardless
# of which directory you run from). Only set this to override, e.g. to point
# at Postgres instead of SQLite.
DATABASE_URL=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
