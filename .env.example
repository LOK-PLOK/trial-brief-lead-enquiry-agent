# Copy this file to .env at the repo root for local (non-Docker) development.
# In Docker/deployment (e.g. Render), these are provided as real environment variables/secrets instead.
#
# See docs/architecture.md (13. Deployment), docs/deployment.md, and server/app/core/config.py
# for how these are consumed.

# --- Model provider selection (provider-agnostic adapter, see server/app/llm/) ---
# One of: openrouter | openai | anthropic | ollama
# Only `openrouter` has a real ModelAdapter implementation today
# (server/app/llm/openrouter_adapter.py) -- the others remain valid,
# documented extension points with no adapter behind them yet.
MODEL_PROVIDER=openrouter

# Default model used by every stage unless overridden below. OpenRouter model
# ids are "<vendor>/<model>" -- see https://openrouter.ai/models for the
# full list (e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku,
# google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct).
MODEL_NAME=openai/gpt-4o-mini

# Optional per-stage overrides. Leave unset to fall back to MODEL_NAME.
# Setting a different VERIFIER_MODEL is a documented mitigation for verifier
# independence (see docs/architecture.md, 9. Verifier Architecture).
PLANNER_MODEL=
EXTRACTOR_MODEL=
VERIFIER_MODEL=

# --- Provider credentials (only the one matching MODEL_PROVIDER is required) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Database ---
# Leave unset (blank) to use the built-in default: <repo_root>/server/data/app.db
# (computed in server/app/core/config.py so it resolves correctly regardless
# of which directory you run from). Only set this to override, e.g. to point
# at Postgres instead of SQLite. An explicitly blank value here is treated
# the same as unset (see Settings._default_database_url_when_blank).
DATABASE_URL=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
