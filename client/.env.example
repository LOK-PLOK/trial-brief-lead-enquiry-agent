# Backend origin for API requests.
#
# Local development (default): leave unset or empty so Vite proxies `/api`
# to the backend (see vite.config.ts). Optionally set:
#   VITE_API_BASE_URL=http://localhost:8000
#
# Render (separate frontend + backend services): set this to your backend
# public URL with no trailing slash, for example:
#   VITE_API_BASE_URL=https://your-api-service.onrender.com
# Configure the same value as a Vite build env var on the frontend service
# so it is baked in at build time.
#
# Single-container / same-origin deploy: leave unset (relative `/api/...`).

VITE_API_BASE_URL=http://localhost:8000
